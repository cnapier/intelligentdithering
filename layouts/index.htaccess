{{- /* Generated into public/.htaccess (see [outputFormats.htaccess] in config.toml). */ -}}
ErrorDocument 404 /404.html

# --- Browser caching -------------------------------------------------------
# Pages, feeds and the search index: browsers must check for a newer copy every
# time (a quick 304 "not modified" when nothing changed), so updates show at once.
# CSS/JS that Hugo fingerprints (name contains a hash) never change, so cache them
# for a year. Images and other files: a week.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|json|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|mp4|webm|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Must come after the rule above so it wins for fingerprinted files
  <FilesMatch "\.[0-9a-f]{64}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# --- Security headers --------------------------------------------------------
# HSTS: browsers only ever use https for this domain (1 year). No includeSubDomains,
# so any subdomain that isn't on https yet is unaffected.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
</IfModule>

# Old WordPress feed URLs -> Hugo feeds (permanent, so feed readers update the subscription)
RedirectMatch 301 ^/feed/?$ /index.xml
RedirectMatch 301 ^/feed/(rss|rss2|atom|rdf)/?$ /index.xml
RedirectMatch 301 ^/category/([^/]+)/feed/?$ /categories/$1/index.xml
RedirectMatch 301 ^/tag/([^/]+)/feed/?$ /tags/$1/index.xml

# Retired/merged tags and categories (data/taxonomy_redirects.toml). These come
# before the generic rules below because the first matching rule wins.
{{ range $kind, $map := hugo.Data.taxonomy_redirects -}}
{{- $wp := cond (eq $kind "tags") "tag" "category" -}}
{{- range $old, $new := $map }}
RedirectMatch 301 ^/({{ $kind }}|{{ $wp }})/{{ $old }}/?$ {{ $new }}
RedirectMatch 301 ^/({{ $kind }}|{{ $wp }})/{{ $old }}/(index\.xml|feed/?)$ {{ $new }}index.xml
{{- end }}
{{- end }}

# Old WordPress archive URLs -> Hugo taxonomy pages
RedirectMatch 301 ^/category/([^/]+)/?$ /categories/$1/
RedirectMatch 301 ^/tag/([^/]+)/?$ /tags/$1/

# Old WordPress post URLs -> new post URLs.
# Built from each page's `aliases`. Hugo also writes meta-refresh pages for these as a
# fallback, but a real 301 passes ranking signals cleanly and is what Google prefers.
{{ range site.Pages -}}
{{- $to := .RelPermalink -}}
{{- range .Aliases -}}
{{- $from := . | strings.TrimSuffix "/" | replaceRE `([.+?()\[\]])` `\$1` -}}
{{- if and $from (ne (printf "%s/" $from) $to) }}
RedirectMatch 301 ^{{ $from }}/?$ {{ $to }}
{{- end -}}
{{- end -}}
{{- end }}
