RedirectMatch 301 ^/(tags|tag)/tools/?$ /tags/sysadmin/
RedirectMatch 301 ^/(tags|tag)/tools/(index\.xml|feed/?)$ /tags/sysadmin/index.xml

# Old WordPress archive URLs -> Hugo taxonomy pages
RedirectMatch 301 ^/category/([^/]+)/?$ /categories/$1/
RedirectMatch 301 ^/tag/([^/]+)/?$ /tags/$1/

# Old WordPress post URLs -> new post URLs.
# Built from each page's `aliases`. Hugo also writes meta-refresh pages for these as a
# fallback, but a real 301 passes ranking signals cleanly and is what Google prefers.

RedirectMatch 301 ^/posts/2025/07/dual-screen-diy-cyberdeck/?$ /dual-screen-diy-cyberdeck/
