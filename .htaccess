RedirectMatch 301 ^/(tags|tag)/home-assistant/(index\.xml|feed/?)$ /tags/home-automation/index.xml
RedirectMatch 301 ^/(tags|tag)/macos/?$ /tags/mac/
RedirectMatch 301 ^/(tags|tag)/macos/(index\.xml|feed/?)$ /tags/mac/index.xml
RedirectMatch 301 ^/(tags|tag)/mental-health/?$ /tags/wellbeing/
RedirectMatch 301 ^/(tags|tag)/mental-health/(index\.xml|feed/?)$ /tags/wellbeing/index.xml
RedirectMatch 301 ^/(tags|tag)/moodle/?$ /tags/education/
