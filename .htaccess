ErrorDocument 404 /404.html

# --- Browser caching -------------------------------------------------------
# Pages, feeds and the search index: browsers must check for a newer copy every
# time (a quick 304 "not modified" when nothing changed), so updates show at once.
# CSS/JS that Hugo fingerprints (name contains a hash) never change, so cache them
# for a year. Images and other files: a week.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|json|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.[0-9a-f]{64}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Old WordPress feed URLs -> Hugo feeds (permanent, so feed readers update the subscription)
RedirectMatch 301 ^/feed/?$ /index.xml
RedirectMatch 301 ^/feed/(rss|rss2|atom|rdf)/?$ /index.xml
RedirectMatch 301 ^/category/([^/]+)/feed/?$ /categories/$1/index.xml
RedirectMatch 301 ^/tag/([^/]+)/feed/?$ /tags/$1/index.xml

# Retired/merged tags and categories (data/taxonomy_redirects.toml). These come
# before the generic rules below because the first matching rule wins.

RedirectMatch 301 ^/(categories|category)/mental-health/?$ /categories/personal/
RedirectMatch 301 ^/(categories|category)/mental-health/(index\.xml|feed/?)$ /categories/personal/index.xml
RedirectMatch 301 ^/(tags|tag)/apple/?$ /tags/ios/
RedirectMatch 301 ^/(tags|tag)/apple/(index\.xml|feed/?)$ /tags/ios/index.xml
RedirectMatch 301 ^/(tags|tag)/digital-signage/?$ /tags/maker/
RedirectMatch 301 ^/(tags|tag)/digital-signage/(index\.xml|feed/?)$ /tags/maker/index.xml
RedirectMatch 301 ^/(tags|tag)/dyslexia/?$ /tags/education/
RedirectMatch 301 ^/(tags|tag)/dyslexia/(index\.xml|feed/?)$ /tags/education/index.xml
RedirectMatch 301 ^/(tags|tag)/energy-monitoring/?$ /tags/home-automation/
RedirectMatch 301 ^/(tags|tag)/energy-monitoring/(index\.xml|feed/?)$ /tags/home-automation/index.xml
RedirectMatch 301 ^/(tags|tag)/fitness/?$ /tags/wellbeing/
