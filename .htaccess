RedirectMatch 301 ^/(tags|tag)/news/?$ /categories/news/
RedirectMatch 301 ^/(tags|tag)/news/(index\.xml|feed/?)$ /categories/news/index.xml
RedirectMatch 301 ^/(tags|tag)/personal/?$ /categories/personal/
RedirectMatch 301 ^/(tags|tag)/personal/(index\.xml|feed/?)$ /categories/personal/index.xml
RedirectMatch 301 ^/(tags|tag)/recommended/?$ /categories/recommended/
RedirectMatch 301 ^/(tags|tag)/recommended/(index\.xml|feed/?)$ /categories/recommended/index.xml
RedirectMatch 301 ^/(tags|tag)/setapp/?$ /tags/mac/
RedirectMatch 301 ^/(tags|tag)/setapp/(index\.xml|feed/?)$ /tags/mac/index.xml
RedirectMatch 301 ^/(tags|tag)/shortcuts/?$ /tags/productivity/
RedirectMatch 301 ^/(tags|tag)/shortcuts/(index\.xml|feed/?)$ /tags/productivity/index.xml
RedirectMatch 301 ^/(tags|tag)/task-management/?$ /tags/productivity/
